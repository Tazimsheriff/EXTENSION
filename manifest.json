{
  "manifest_version": 3,
  "name": "HackFill - Hackathon & Event AutoFill",
  "version": "1.0.0",
  "description": "One-click autofill for hackathons & events. Store personal links, teammate profiles, pitch answers, and track your applications.",

  "browser_specific_settings": {
    "gecko": {
      "id": "hackfill@extension",
      "strict_min_version": "109.0"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "HackFill Dashboard"
  },
  "background": {
    "service_worker": "background/background.js",
    "scripts": ["background/background.js"]
  },
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "autofill_form": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Autofill current hackathon form"
    }
  }
}
