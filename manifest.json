{
  "manifest_version": 3,
  "name": "HackFill",
  "version": "2.1.0",
  "description": "Autofill hackathon forms, keep a team lineup, and open registration links by pointing at a QR code.",
  "browser_specific_settings": {
    "gecko": {
      "id": "hackfill@extension",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "HackFill",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "scripts": ["background/background.js"],
    "service_worker": "background/background.js"
  },
  "permissions": ["storage", "activeTab", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/jsQR.min.js", "lib/qrscan.js", "content/content.js", "content/qr.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/hud.css", "assets/fonts/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "autofill_form": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Autofill the current form"
    }
  }
}
